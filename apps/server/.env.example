# App
APP_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
HOST=127.0.0.1
NODE_ENV=development
PORT=3000

# Auth
# Replace with a unique value before deployment (must be at least 32 characters)
BETTER_AUTH_SECRET=change-me-use-a-generated-secret-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional: required only to enable Google sign-in
# GOOGLE_CLIENT_SECRET=secret1234
# GOOGLE_CLIENT_ID=12340.apps.googleusercontent.com

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/database_name
