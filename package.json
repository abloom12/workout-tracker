{
  "name": "workout-tracker",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.34.5"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev -F=@acme/web -F=@acme/server",
    "dev:check": "turbo watch dev typecheck lint --continue=always -F=@acme/web -F=@acme/server -F=@acme/api -F=@acme/auth -F=@acme/db",
    "dev:server": "turbo watch dev -F=@acme/server",
    "dev:web": "turbo watch dev -F=@acme/web",
    "db:up": "docker compose up postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm -F @acme/db run db:generate",
    "db:migrate": "pnpm -F @acme/db run db:migrate",
    "db:push": "pnpm -F @acme/db run db:push",
    "db:seed": "pnpm -F @acme/db run db:seed",
    "db:studio": "pnpm -F @acme/db run db:studio",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.11.2",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
